<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="file/parameter" default="$(find-pkg-share sparse4d)/config/sparse4d.param.yaml"/>
  <arg name="output/boxes" default="/sparse4d/output/boxes"/>
  <arg name="use_raw" default="false"/>
  <arg name="build_only" default="false"/>
  <arg name="visualize" default="true"/>

  <node pkg="sparse4d" exec="sparse4d_component_exe" name="detector" output="screen">
    <param from="$(var file/parameter)" allow_substs="true"/>
    <param name="use_raw" value="$(var use_raw)"/>
    <param name="build_only" value="$(var build_only)"/>
    <remap from="~/output/boxes" to="$(var output/boxes)"/>
  </node>

  <group if="$(var visualize)">
    <node pkg="mmrviz" exec="box_array3d_visualizer_exe" name="box_array3d_cam_front" output="screen">
      <param name="use_raw" value="$(var use_raw)"/>
      <remap from="~/input/image" to="/nuscenes/CAM_FRONT/image"/>
      <remap from="~/input/camera_info" to="/nuscenes/CAM_FRONT/camera_info"/>
      <remap from="~/input/boxes" to="$(var output/boxes)"/>
    </node>
  </group>
</launch>
